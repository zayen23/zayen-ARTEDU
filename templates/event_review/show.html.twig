{% extends 'base.html.twig' %}

{% block title %}Détails du commentaire{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="page-title">
                <i class="fas fa-star"></i>
                Détails du commentaire
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_event_review_index') }}">Commentaires</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Détails</li>
                </ol>
            </nav>
        </div>
        <a href="{{ path('app_event_review_index') }}" class="btn btn-reset">
            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
        </a>
    </div>
</div>

<div class="stat-card">
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ event_review.id }}</td>
            </tr>
            <tr>
                <th>Rating</th>
                <td>{{ event_review.rating }}</td>
            </tr>
            <tr>
                <th>Comment</th>
                <td>{{ event_review.comment }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ event_review.createdAt ? event_review.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>
    
    <div class="mt-4">
        <a href="{{ path('app_event_review_edit', {'id': event_review.id}) }}" class="btn btn-add">
            <i class="fas fa-edit me-2"></i>Modifier
        </a>
        {{ include('event_review/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}


