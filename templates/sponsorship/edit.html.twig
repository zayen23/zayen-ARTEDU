{% extends 'base.html.twig' %}

{% block title %}Modifier le Parrainage{% endblock %}

{% block body %}
    <div class="mb-4">
        <h1 class="fw-bold mb-2"><i class="bi bi-pencil-square"></i> Modifier le Parrainage</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_sponsorship_index') }}">Parrainages</a></li>
                <li class="breadcrumb-item active">#{{ sponsorship.id }}</li>
            </ol>
        </nav>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('sponsorship/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="mt-3">
        {{ include('sponsorship/_delete_form.html.twig') }}
    </div>
{% endblock %}

