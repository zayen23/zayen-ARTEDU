{% extends 'base.html.twig' %}

{% block title %}Détails du Parrainage{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-2"><i class="bi bi-handshake"></i> Détails du Parrainage</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_sponsorship_index') }}">Parrainages</a></li>
                    <li class="breadcrumb-item active">Détails</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <th width="200">Description</th>
                        <td>{{ sponsorship.description }}</td>
                    </tr>
                    <tr>
                        <th>Sponsor</th>
                        <td><strong>{{ sponsorship.sponsor.name }}</strong></td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td><span class="badge bg-secondary">{{ sponsorship.type.value }}</span></td>
                    </tr>
                    <tr>
                        <th>Type de parrainage</th>
                        <td><span class="badge bg-primary">{{ sponsorship.sponsorshipType.value }}</span></td>
                    </tr>
                    <tr>
                        <th>Montant</th>
                        <td><strong class="text-success fs-5">{{ sponsorship.amount|number_format(2, ',', ' ') }} €</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_sponsorship_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_sponsorship_edit', {'id': sponsorship.id}) }}" class="btn btn-warning">Modifier</a>
        {{ include('sponsorship/_delete_form.html.twig') }}
    </div>
{% endblock %}

