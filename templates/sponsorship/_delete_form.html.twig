<form method="post" action="{{ path('app_sponsorship_delete', {'id': sponsorship.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce parrainage ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsorship.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>

