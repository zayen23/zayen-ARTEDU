{% extends 'base.html.twig' %}

{% block title %}Sponsoring - Actions Rapides{% endblock %}

{% block body %}
<div class="page-header">
    <h1>
        <i class="fas fa-handshake"></i>
        Sponsoring
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Sponsoring</li>
        </ol>
    </nav>
</div>

<div class="data-table-container" style="text-align: center; padding: 60px 40px;">
    <h2 style="font-size: 28px; font-weight: 700; color: #1e293b; margin-bottom: 12px;">Actions rapides</h2>
    <p style="font-size: 16px; color: #64748b; margin-bottom: 40px;">Créez rapidement de nouveaux éléments</p>
    
    <div style="max-width: 900px; margin: 0 auto;">
        <!-- Première ligne : Créer un Sponsor et Créer un Contrat -->
        <div style="display: flex; justify-content: center; gap: 24px; margin-bottom: 24px; flex-wrap: wrap;">
            <!-- Bouton Créer un Sponsor (Bleu) -->
            <a href="{{ path('app_sponsor_new') }}" style="
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 20px 32px;
                background: #3b82f6;
                color: white;
                text-decoration: none;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 600;
                transition: all 0.3s;
                box-shadow: 0 4px 6px rgba(59, 130, 246, 0.3);
                min-width: 220px;
            " onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 12px rgba(59, 130, 246, 0.4)';" 
               onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px rgba(59, 130, 246, 0.3)';">
                <i class="fas fa-user-plus" style="font-size: 20px;"></i>
                <span>Créer un Sponsor</span>
            </a>

            <!-- Bouton Créer un Contrat (Vert) -->
            <a href="{{ path('app_sponsor_contract_new') }}" style="
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 20px 32px;
                background: #10b981;
                color: white;
                text-decoration: none;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 600;
                transition: all 0.3s;
                box-shadow: 0 4px 6px rgba(16, 185, 129, 0.3);
                min-width: 220px;
            " onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 12px rgba(16, 185, 129, 0.4)';" 
               onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px rgba(16, 185, 129, 0.3)';">
                <i class="fas fa-file-contract" style="font-size: 20px;"></i>
                <span>Créer un Contrat</span>
            </a>
        </div>

        <!-- Deuxième ligne : Créer un Parrainage (centré) -->
        <div style="display: flex; justify-content: center;">
            <a href="{{ path('app_sponsorship_new') }}" style="
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 20px 32px;
                background: #06b6d4;
                color: #1e293b;
                text-decoration: none;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 600;
                transition: all 0.3s;
                box-shadow: 0 4px 6px rgba(6, 182, 212, 0.3);
                min-width: 220px;
            " onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 12px rgba(6, 182, 212, 0.4)';" 
               onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px rgba(6, 182, 212, 0.3)';">
                <i class="fas fa-gift" style="font-size: 20px;"></i>
                <span>Créer un Parrainage</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}

