{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - ARTEDU{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Tableau de bord</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Accueil</li>
    </ol>

    <!-- Stats Section -->
    <div id="stats" class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Sponsors</div>
                            <div class="h2">{{ sponsors_count }}</div>
                        </div>
                        <div><i class="fas fa-handshake fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('app_sponsor_index') }}">Voir détails</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Contrats</div>
                            <div class="h2">{{ contracts_count }}</div>
                        </div>
                        <div><i class="fas fa-file-contract fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('app_sponsor_contract_index') }}">Voir détails</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Parrainages</div>
                            <div class="h2">{{ sponsorships_count }}</div>
                        </div>
                        <div><i class="fas fa-gift fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('app_sponsorship_index') }}">Voir détails</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Total</div>
                            <div class="h2">{{ sponsors_count + contracts_count + sponsorships_count }}</div>
                        </div>
                        <div><i class="fas fa-chart-line fa-2x"></i></div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <span class="small text-white">Éléments totaux</span>
                    <div class="small text-white"><i class="fas fa-chart-bar"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-4 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-handshake me-1"></i>
                    Derniers Sponsors
                </div>
                <div class="card-body">
                    {% if recent_sponsors|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for sponsor in recent_sponsors %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>{{ sponsor.name }}</strong>
                                        <br>
                                        <small class="text-muted">{{ sponsor.email }}</small>
                                    </div>
                                    <a href="{{ path('app_sponsor_show', {'id': sponsor.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Aucun sponsor</p>
                    {% endif %}
                    <div class="mt-3">
                        <a href="{{ path('app_sponsor_index') }}" class="btn btn-primary btn-sm w-100">Voir tous les sponsors</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-file-contract me-1"></i>
                    Derniers Contrats
                </div>
                <div class="card-body">
                    {% if recent_contracts|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for contract in recent_contracts %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>{{ contract.contractNumber }}</strong>
                                        <br>
                                        <small class="text-muted">{{ contract.sponsor.name }}</small>
                                    </div>
                                    <a href="{{ path('app_sponsor_contract_show', {'id': contract.id}) }}" class="btn btn-sm btn-outline-success">Voir</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Aucun contrat</p>
                    {% endif %}
                    <div class="mt-3">
                        <a href="{{ path('app_sponsor_contract_index') }}" class="btn btn-success btn-sm w-100">Voir tous les contrats</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-gift me-1"></i>
                    Derniers Parrainages
                </div>
                <div class="card-body">
                    {% if recent_sponsorships|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for sponsorship in recent_sponsorships %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>{{ sponsorship.sponsor.name }}</strong>
                                        <br>
                                        <small class="text-muted">{{ sponsorship.amount|number_format(2, ',', ' ') }} €</small>
                                    </div>
                                    <a href="{{ path('app_sponsorship_show', {'id': sponsorship.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Aucun parrainage</p>
                    {% endif %}
                    <div class="mt-3">
                        <a href="{{ path('app_sponsorship_index') }}" class="btn btn-info btn-sm w-100">Voir tous les parrainages</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body text-center p-5">
                    <h3 class="fw-bold mb-3">Actions rapides</h3>
                    <p class="text-muted mb-4">Créez rapidement de nouveaux éléments</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="{{ path('app_sponsor_new') }}" class="btn btn-primary btn-lg">
                            <i class="fas fa-user-plus"></i> Créer un Sponsor
                        </a>
                        <a href="{{ path('app_sponsor_contract_new') }}" class="btn btn-success btn-lg">
                            <i class="fas fa-file-contract"></i> Créer un Contrat
                        </a>
                        <a href="{{ path('app_sponsorship_new') }}" class="btn btn-info btn-lg">
                            <i class="fas fa-gift"></i> Créer un Parrainage
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
