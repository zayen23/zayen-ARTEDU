{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs - ARTEDU{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="page-title">
                <i class="fas fa-users"></i>
                Gestion des Utilisateurs
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Utilisateurs</li>
                </ol>
            </nav>
        </div>
        <a href="#" class="btn btn-add">
            <i class="fas fa-plus me-2"></i>+ Add New User
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 180px;">
            <div class="card-body text-white d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3 flex-grow-1">
                    <div>
                        <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">CLIENTS</h6>
                        <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ clients_count|default(0) }}</h2>
                    </div>
                    <div>
                        <i class="fas fa-users fa-3x text-white" style="opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 180px;">
            <div class="card-body text-white d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3 flex-grow-1">
                    <div>
                        <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">VENDEURS</h6>
                        <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ vendeurs_count|default(0) }}</h2>
                    </div>
                    <div>
                        <i class="fas fa-store fa-3x text-white" style="opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 180px;">
            <div class="card-body text-white d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3 flex-grow-1">
                    <div>
                        <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">ADMINISTRATEURS</h6>
                        <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ admins_count|default(0) }}</h2>
                    </div>
                    <div>
                        <i class="fas fa-user-shield fa-3x text-white" style="opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 180px;">
            <div class="card-body text-white d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3 flex-grow-1">
                    <div>
                        <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">TOTAL UTILISATEURS</h6>
                        <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ total_users|default(0) }}</h2>
                    </div>
                    <div>
                        <i class="fas fa-chart-line fa-3x text-white" style="opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Navigation Panel -->
    <div class="col-xl-3 col-lg-4 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action active" id="filterAll" onclick="filterUsers('all'); return false;">
                        <i class="fas fa-users me-2"></i>
                        Tous les utilisateurs
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" id="filterClients" onclick="filterUsers('clients'); return false;">
                        <i class="fas fa-user me-2"></i>
                        Clients
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" id="filterVendeurs" onclick="filterUsers('vendeurs'); return false;">
                        <i class="fas fa-store me-2"></i>
                        Vendeurs
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" id="filterAdmins" onclick="filterUsers('admins'); return false;">
                        <i class="fas fa-user-shield me-2"></i>
                        Administrateurs
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-xl-9 col-lg-8">
        <!-- Search and Filter Section -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Rechercher par nom, email..." onkeyup="filterTable()">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="statusFilter" onchange="filterTable()">
                            <option value="">Tous les statuts</option>
                            <option value="actif">Actif</option>
                            <option value="inactif">Inactif</option>
                            <option value="en_attente">En attente</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                            <i class="fas fa-redo"></i> Réinitialiser
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="usersTable">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Email</th>
                                <th>Type</th>
                                <th>Statut</th>
                                <th>Date de création</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fas fa-users fa-3x mb-3 d-block" style="opacity: 0.3;"></i>
                                    <p>Aucun utilisateur trouvé</p>
                                    <a href="#" class="btn btn-primary btn-sm">
                                        <i class="fas fa-plus"></i> Créer un utilisateur
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.list-group-item.active {
    background-color: #7c3aed !important;
    border-color: #7c3aed !important;
    color: white !important;
}

.list-group-item.active i {
    color: white !important;
}

.list-group-item {
    border-left: none;
    border-right: none;
    border-top: 1px solid #e5e7eb;
    cursor: pointer;
    transition: all 0.2s;
    padding: 12px 16px;
    font-weight: 500;
}

.list-group-item:first-child {
    border-top: none;
}

.list-group-item:hover:not(.active) {
    background-color: #f8f9fa;
}

.list-group-item i {
    width: 20px;
    text-align: center;
    margin-right: 8px;
    color: #6b7280;
}
</style>

<script>
function filterUsers(type) {
    document.querySelectorAll('.list-group-item').forEach(item => {
        item.classList.remove('active');
    });
    event.target.closest('.list-group-item').classList.add('active');
    console.log('Filter by:', type);
}

function filterTable() {
    const searchInput = document.getElementById('searchInput').value.toLowerCase();
    const table = document.getElementById('usersTableBody');
    const rows = table.getElementsByTagName('tr');
    
    for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchInput) ? '' : 'none';
    }
}

function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('statusFilter').value = '';
    filterTable();
}
</script>
{% endblock %}
