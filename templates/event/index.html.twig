{% extends 'base.html.twig' %}

{% block title %}Liste des Événements{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Liste des Événements</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
        <li class="breadcrumb-item active">Événements</li>
    </ol>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted">Consultez tous les événements disponibles</p>
    </div>

    {% if events|length > 0 %}
        <div class="row">
            {% for event in events %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">{{ event.title }}</h5>
                            {% if event.description %}
                                <p class="card-text text-muted">{{ event.description|slice(0, 100) }}{% if event.description|length > 100 %}...{% endif %}</p>
                            {% endif %}
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="fas fa-calendar"></i> {{ event.startDate|date('d/m/Y H:i') }}
                                    {% if event.location %}
                                        <br><i class="fas fa-map-marker-alt"></i> {{ event.location }}
                                    {% endif %}
                                </small>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-eye"></i> Voir les détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            <p class="mb-0">Aucun événement trouvé.</p>
        </div>
    {% endif %}
</div>
{% endblock %}



