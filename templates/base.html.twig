<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{% block title %}My Symfony App - Dashboard{% endblock %}</title>

    <!-- Favicon SVG -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><text y='1.2em' font-size='96'>🎨</text></svg>">

    <!-- Styles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://use.fontawesome.com/releases/v6.3.0/css/all.css" rel="stylesheet" crossorigin="anonymous">
    <link href="{{ asset('css/modern-dashboard.css') }}" rel="stylesheet" />

    {% block stylesheets %}{% endblock %}
</head>
<body>

    {# === HEADER === #}
    {% if hide_navbar is not defined or not hide_navbar %}
        {% include 'partials/_navbar.html.twig' %}
    {% endif %}

    {# === SIDEBAR === #}
    {% if hide_navbar is not defined or not hide_navbar %}
        {% include 'partials/_sidebar.html.twig' %}
    {% endif %}

    {# === MAIN CONTENT === #}
    <div class="main-content">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </div>

    {# === SCRIPTS === #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="{{ asset('js/scripts.js') }}"></script>

    <script>
        // Toggle sidebar
        document.addEventListener('DOMContentLoaded', function () {
            const menuToggle = document.getElementById('menuToggle');
            if (menuToggle) {
                menuToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.body.classList.toggle('sidebar-collapsed');
                    localStorage.setItem('sidebar-collapsed', document.body.classList.contains('sidebar-collapsed'));
                });
            }

            // Restore sidebar state
            if (localStorage.getItem('sidebar-collapsed') === 'true') {
                document.body.classList.add('sidebar-collapsed');
            }

            // Set active menu items
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.modern-sidebar .nav-link');
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href && currentPath.startsWith(href) && href !== '/') {
                    link.classList.add('active');
                }
            });

            // Handle home page
            if (currentPath === '/' || currentPath === '/home') {
                const homeLink = document.querySelector('.modern-sidebar .nav-link[href*="home"]');
                if (homeLink) {
                    homeLink.classList.add('active');
                }
            }

            // Toggle Sponsoring actions function
            window.toggleSponsoringActions = function() {
                const sponsoringToggleIcon = document.getElementById('sponsoringToggle');
                const sponsoringActions = document.getElementById('sponsoringActions');
                
                if (sponsoringActions) {
                    const isCurrentlyOpen = sponsoringActions.style.display === 'block';
                    
                    if (isCurrentlyOpen) {
                        sponsoringActions.style.display = 'none';
                        if (sponsoringToggleIcon) {
                            sponsoringToggleIcon.style.transform = 'rotate(0deg)';
                        }
                        localStorage.setItem('sponsoring-actions-open', 'false');
                    } else {
                        sponsoringActions.style.display = 'block';
                        if (sponsoringToggleIcon) {
                            sponsoringToggleIcon.style.transform = 'rotate(180deg)';
                        }
                        localStorage.setItem('sponsoring-actions-open', 'true');
                    }
                }
            };
            
            // Restore Sponsoring actions state from localStorage
            const sponsoringActions = document.getElementById('sponsoringActions');
            const sponsoringToggleIcon = document.getElementById('sponsoringToggle');
            if (sponsoringActions && sponsoringToggleIcon) {
                const isOpen = localStorage.getItem('sponsoring-actions-open') === 'true';
                if (isOpen) {
                    sponsoringActions.style.display = 'block';
                    sponsoringToggleIcon.style.transform = 'rotate(180deg)';
                }
            }

            // Toggle Events actions function
            window.toggleEventsActions = function() {
                const eventsToggleIcon = document.getElementById('eventsToggle');
                const eventsActions = document.getElementById('eventsActions');
                
                if (eventsActions) {
                    const isCurrentlyOpen = eventsActions.style.display === 'block';
                    
                    if (isCurrentlyOpen) {
                        eventsActions.style.display = 'none';
                        if (eventsToggleIcon) {
                            eventsToggleIcon.style.transform = 'rotate(0deg)';
                        }
                        localStorage.setItem('events-actions-open', 'false');
                    } else {
                        eventsActions.style.display = 'block';
                        if (eventsToggleIcon) {
                            eventsToggleIcon.style.transform = 'rotate(180deg)';
                        }
                        localStorage.setItem('events-actions-open', 'true');
                    }
                }
            };
            
            // Restore Events actions state from localStorage
            const eventsActions = document.getElementById('eventsActions');
            const eventsToggleIcon = document.getElementById('eventsToggle');
            if (eventsActions && eventsToggleIcon) {
                const isOpen = localStorage.getItem('events-actions-open') === 'true';
                if (isOpen) {
                    eventsActions.style.display = 'block';
                    eventsToggleIcon.style.transform = 'rotate(180deg)';
                }
            }

            // Toggle Ventes actions function
            window.toggleVentesActions = function() {
                const ventesToggleIcon = document.getElementById('ventesToggle');
                const ventesActions = document.getElementById('ventesActions');
                
                if (ventesActions) {
                    const isCurrentlyOpen = ventesActions.style.display === 'block';
                    
                    if (isCurrentlyOpen) {
                        ventesActions.style.display = 'none';
                        if (ventesToggleIcon) {
                            ventesToggleIcon.style.transform = 'rotate(0deg)';
                        }
                        localStorage.setItem('ventes-actions-open', 'false');
                    } else {
                        ventesActions.style.display = 'block';
                        if (ventesToggleIcon) {
                            ventesToggleIcon.style.transform = 'rotate(180deg)';
                        }
                        localStorage.setItem('ventes-actions-open', 'true');
                    }
                }
            };
            
            // Restore Ventes actions state from localStorage
            const ventesActions = document.getElementById('ventesActions');
            const ventesToggleIcon = document.getElementById('ventesToggle');
            if (ventesActions && ventesToggleIcon) {
                const isOpen = localStorage.getItem('ventes-actions-open') === 'true';
                if (isOpen) {
                    ventesActions.style.display = 'block';
                    ventesToggleIcon.style.transform = 'rotate(180deg)';
                }
            }
        });
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
