{% extends 'base.html.twig' %}

{% block title %}Liste des Sponsors{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Liste des Sponsors</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
        <li class="breadcrumb-item active">Sponsors</li>
    </ol>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">Gérez vos sponsors en un seul endroit</p>
        <a href="{{ path('app_sponsor_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau Sponsor
        </a>
    </div>

    {% if sponsors|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Logo</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for sponsor in sponsors %}
                    <tr>
                        <td>
                            {% if sponsor.logo %}
                                <img src="{{ asset('uploads/sponsors/' ~ sponsor.logo) }}" 
                                     alt="Logo {{ sponsor.name }}" 
                                     style="max-height: 50px; max-width: 100px; object-fit: contain;">
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td><strong>{{ sponsor.name }}</strong></td>
                        <td><i class="fas fa-envelope"></i> {{ sponsor.email }}</td>
                        <td><i class="fas fa-phone"></i> {{ sponsor.phone }}</td>
                        <td><span class="badge bg-primary">{{ sponsor.type.value }}</span></td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_sponsor_show', {'id': sponsor.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_sponsor_edit', {'id': sponsor.id}) }}" class="btn btn-sm btn-outline-warning">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            <p class="mb-0">Aucun sponsor trouvé. <a href="{{ path('app_sponsor_new') }}">Créer le premier sponsor</a></p>
        </div>
    {% endif %}
</div>
{% endblock %}
