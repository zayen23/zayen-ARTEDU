{% extends 'base.html.twig' %}

{% block title %}Gestion des Sponsors{% endblock %}

{% block body %}
<div class="page-header">
    <h1>
        <i class="fas fa-users-cog"></i>
        Gestion des Sponsors
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Sponsors</li>
        </ol>
    </nav>
</div>

{% if sponsors|length > 0 %}
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for sponsor in sponsors %}
                <tr>
                    <td class="logo-cell">
                        {% if sponsor.logo %}
                            <img src="{{ asset('uploads/sponsors/' ~ sponsor.logo) }}" 
                                 alt="Logo {{ sponsor.name }}">
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td><strong>{{ sponsor.name }}</strong></td>
                    <td>
                        <i class="fas fa-envelope"></i> 
                        {{ sponsor.email }}
                    </td>
                    <td>
                        <i class="fas fa-phone"></i> 
                        {{ sponsor.phone }}
                    </td>
                    <td>
                        <span class="badge" style="background: #3b82f6; color: white;">
                            {{ sponsor.type.value }}
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ path('app_sponsor_show', {'id': sponsor.id}) }}" class="btn-sm btn-view">
                                <i class="fas fa-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_sponsor_edit', {'id': sponsor.id}) }}" class="btn-sm btn-edit">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="data-table-container">
        <div class="alert alert-info" style="margin: 0;">
            <p class="mb-0">Aucun sponsor trouvé. <a href="{{ path('app_sponsor_new') }}">Créer le premier sponsor</a></p>
        </div>
    </div>
{% endif %}
{% endblock %}
