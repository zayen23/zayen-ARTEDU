{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.contractNumber, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.sponsor, {'attr': {'class': 'form-select'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            {{ form_row(form.signedAt, {'attr': {'class': 'form-control', 'id': 'signedAt'}}) }}
        </div>
        <div class="col-md-4 mb-3">
            {{ form_row(form.expiresAt, {'attr': {'class': 'form-control', 'id': 'expiresAt'}}) }}
        </div>
        <div class="col-md-4 mb-3">
            {{ form_row(form.level, {'attr': {'class': 'form-select'}}) }}
        </div>
    </div>
    <div class="mb-3">
        {{ form_row(form.terms, {'attr': {'class': 'form-control', 'rows': 5}}) }}
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
        <a href="{{ path('app_sponsor_contract_index') }}" class="btn btn-secondary">Annuler</a>
    </div>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const signedAtInput = document.getElementById('signedAt');
    const expiresAtInput = document.getElementById('expiresAt');
    const contractNumberInput = document.querySelector('input[name*="[contractNumber]"]');
    const termsTextarea = document.querySelector('textarea[name*="[terms]"]');
    
    // Validation du numéro de contrat
    if (contractNumberInput) {
        contractNumberInput.addEventListener('input', function() {
            // Nettoyer le champ (garder seulement lettres, chiffres, tirets, underscores)
            this.value = this.value.replace(/[^A-Z0-9\-_]/gi, '');
        });
        
        contractNumberInput.addEventListener('blur', function() {
            const value = this.value;
            if (value && (value.length < 3 || value.length > 100)) {
                this.setCustomValidity('Le numéro de contrat doit contenir entre 3 et 100 caractères');
            } else {
                this.setCustomValidity('');
            }
        });
    }
    
    // Validation des conditions
    if (termsTextarea) {
        termsTextarea.addEventListener('blur', function() {
            const value = this.value.trim();
            if (value && (value.length < 10 || value.length > 5000)) {
                this.setCustomValidity('Les conditions doivent contenir entre 10 et 5000 caractères');
            } else {
                this.setCustomValidity('');
            }
        });
    }
    
    // Mettre à jour la date minimum d'expiration quand la date de signature change
    if (signedAtInput && expiresAtInput) {
        signedAtInput.addEventListener('change', function() {
            if (this.value) {
                const signedDate = new Date(this.value);
                signedDate.setDate(signedDate.getDate() + 1);
                const minDate = signedDate.toISOString().split('T')[0];
                expiresAtInput.setAttribute('min', minDate);
                
                // Si la date d'expiration est antérieure, la réinitialiser
                if (expiresAtInput.value && expiresAtInput.value <= this.value) {
                    expiresAtInput.value = minDate;
                }
            }
        });
        
        // Validation lors de la saisie de la date d'expiration
        expiresAtInput.addEventListener('change', function() {
            if (signedAtInput.value && this.value) {
                if (this.value <= signedAtInput.value) {
                    this.setCustomValidity('La date d\'expiration doit être postérieure à la date de signature');
                } else {
                    this.setCustomValidity('');
                }
            }
        });
    }
});
</script>
