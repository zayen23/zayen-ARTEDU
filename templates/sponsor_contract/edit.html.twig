{% extends 'base.html.twig' %}

{% block title %}Modifier le Contrat de Sponsoring{% endblock %}

{% block body %}
    <div class="mb-4">
        <h1 class="fw-bold mb-2"><i class="bi bi-pencil-square"></i> Modifier le Contrat</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_sponsor_contract_index') }}">Contrats</a></li>
                <li class="breadcrumb-item active">{{ sponsor_contract.contractNumber }}</li>
            </ol>
        </nav>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('sponsor_contract/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="mt-3">
        {{ include('sponsor_contract/_delete_form.html.twig') }}
    </div>
{% endblock %}

