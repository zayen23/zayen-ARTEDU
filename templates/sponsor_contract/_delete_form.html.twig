<form method="post" action="{{ path('app_sponsor_contract_delete', {'id': sponsor_contract.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce contrat ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsor_contract.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>

