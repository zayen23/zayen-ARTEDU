{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau ticket{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="page-title">
                <i class="fas fa-ticket-alt"></i>
                Créer un nouveau ticket
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_ticket_index') }}">Ventes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nouveau ticket</li>
                </ol>
            </nav>
        </div>
        <a href="{{ path('app_ticket_index') }}" class="btn btn-reset">
            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
        </a>
    </div>
</div>

<div class="stat-card">
            <h5 class="mb-4"><i class="fas fa-shopping-cart"></i> Informations du ticket</h5>
            <div>
            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
            
            <div class="row">
                <div class="col-md-12 mb-3">
                    {{ form_row(form.event, {
                        'attr': {'class': 'form-select'},
                        'label': 'Événement',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_row(form.buyerName, {
                        'attr': {'class': 'form-control', 'placeholder': 'Nom complet de l\'acheteur'},
                        'label': 'Nom de l\'acheteur',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-md-6 mb-3">
                    {{ form_row(form.buyerEmail, {
                        'attr': {'class': 'form-control', 'placeholder': 'email@example.com'},
                        'label': 'Email de l\'acheteur',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_row(form.price, {
                        'attr': {'class': 'form-control', 'step': '0.01', 'min': '0', 'placeholder': '0.00'},
                        'label': 'Prix (€)',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-md-4 mb-3">
                    {{ form_row(form.quantity, {
                        'attr': {'class': 'form-control', 'min': '1'},
                        'label': 'Quantité',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
                
                <div class="col-md-4 mb-3">
                    {{ form_row(form.seatNumber, {
                        'attr': {'class': 'form-control', 'placeholder': 'Numéro de siège'},
                        'label': 'Numéro de siège',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    {{ form_row(form.issuedAt, {
                        'attr': {'class': 'form-control'},
                        'label': 'Date d\'émission',
                        'label_attr': {'class': 'form-label fw-bold'}
                    }) }}
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="{{ path('app_ticket_index') }}" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Annuler
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Créer le ticket
                </button>
            </div>
            
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}


