{% extends 'base.html.twig' %}

{% block title %}Gestion des Ventes{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="page-title">
                <i class="fas fa-shopping-cart"></i>
                Gestion des Ventes
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Ventes</li>
                </ol>
            </nav>
        </div>
        <a href="{{ path('app_ticket_new') }}" class="btn btn-add">
            <i class="fas fa-plus me-2"></i>Créer un nouveau ticket
        </a>
    </div>
</div>

    <!-- Cartes Statistiques -->
    <div class="row mb-4">
        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">Total tickets</h6>
                            <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ tickets|length|default(0) }}</h2>
                        </div>
                        <div>
                            <i class="fas fa-ticket-alt fa-3x text-white" style="opacity: 0.3;"></i>
                        </div>
                    </div>
                    <a href="{{ path('app_ticket_index') }}" class="btn btn-sm text-white border-white border-2" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(10px);">
                        Voir détails <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">Tickets aujourd'hui</h6>
                            <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ tickets_today|default(0) }}</h2>
                        </div>
                        <div>
                            <i class="fas fa-calendar-day fa-3x text-white" style="opacity: 0.3;"></i>
                        </div>
                    </div>
                    <a href="{{ path('app_ticket_index') }}" class="btn btn-sm text-white border-white border-2" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(10px);">
                        Voir détails <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #00c9ff 0%, #92fe9d 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">Revenus totaux</h6>
                            <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ (total_revenue|default(0))|number_format(0, ',', ' ') }} €</h2>
                        </div>
                        <div>
                            <i class="fas fa-euro-sign fa-3x text-white" style="opacity: 0.3;"></i>
                        </div>
                    </div>
                    <a href="{{ path('app_ticket_index') }}" class="btn btn-sm text-white border-white border-2" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(10px);">
                        Voir détails <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #fbb034 0%, #ffdd00 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="text-white-50 mb-1" style="font-size: 0.875rem; font-weight: 500;">Revenus aujourd'hui</h6>
                            <h2 class="mb-0 text-white" style="font-size: 2.5rem; font-weight: 700;">{{ (revenue_today|default(0))|number_format(0, ',', ' ') }} €</h2>
                        </div>
                        <div>
                            <i class="fas fa-money-bill-wave fa-3x text-white" style="opacity: 0.3;"></i>
                        </div>
                    </div>
                    <a href="{{ path('app_ticket_index') }}" class="btn btn-sm text-white border-white border-2" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(10px);">
                        Voir détails <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau des tickets -->
    <div class="stat-card">
        <h5 class="mb-4"><i class="fas fa-list"></i> Liste des tickets</h5>
        <div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Événement</th>
                            <th>Acheteur</th>
                            <th>Email</th>
                            <th>Prix</th>
                            <th>Quantité</th>
                            <th>Siège</th>
                            <th>Date d'émission</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ticket in tickets %}
                            <tr>
                                <td>
                                    {% if ticket.event %}
                                        <a href="{{ path('app_event_show', {'id': ticket.event.id}) }}" class="text-primary">
                                            {{ ticket.event.title }}
                                        </a>
                                    {% else %}
                                        <span class="text-muted">N/A</span>
                                    {% endif %}
                                </td>
                                <td>{{ ticket.buyerName }}</td>
                                <td>{{ ticket.buyerEmail }}</td>
                                <td><strong>{{ ticket.price ? ticket.price|number_format(2, ',', ' ') ~ ' €' : 'Gratuit' }}</strong></td>
                                <td><span class="badge badge-info">{{ ticket.quantity }}</span></td>
                                <td>{{ ticket.seatNumber ? ticket.seatNumber : '-' }}</td>
                                <td>{{ ticket.issuedAt ? ticket.issuedAt|date('d/m/Y H:i') : 'N/A' }}</td>
                                <td>
                                    <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_ticket_delete', {'id': ticket.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce ticket ?');" style="display: inline-block;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ticket.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">Aucun ticket trouvé</p>
                                    <a href="{{ path('app_ticket_new') }}" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Créer un ticket
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}


